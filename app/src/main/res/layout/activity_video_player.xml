<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/h_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="30dp">

        <!-- Player 16:9 (height set at runtime to screen width * 9/16) -->
        <FrameLayout
            android:id="@+id/playerFrame"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="#000000">

            <WebView
                android:id="@+id/playerWeb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/playerOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/overlayThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#55000000" />

                <ImageButton
                    android:id="@+id/btnPlay"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/nq_play"
                    app:tint="#FFFFFF"
                    android:background="@drawable/bg_h_scrim_circle"
                    android:scaleType="centerInside"
                    android:padding="16dp"
                    android:contentDescription="Oʻynatish" />

                <TextView
                    android:id="@+id/btnOpenYoutube"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:text="↗  YouTube ilovasida ochish"
                    android:fontFamily="@font/manrope"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_h_pill_dark"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/offlineOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#E60E1626"
                android:visibility="gone">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/nq_lock"
                    app:tint="@color/h_text2"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Internet aloqasi yoʻq"
                    android:fontFamily="@font/lora"
                    android:textStyle="bold"
                    android:textColor="@color/h_text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Qayta urinish"
                    android:fontFamily="@font/manrope"
                    android:textStyle="bold"
                    android:textColor="@color/h_bg"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_h_btn_turq"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />
            </LinearLayout>

            <!-- Professional floating back button -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_margin="10dp"
                android:src="@drawable/nq_back"
                app:tint="#FFFFFF"
                android:background="@drawable/bg_h_scrim_circle"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:contentDescription="Orqaga" />
        </FrameLayout>

        <!-- Details -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvVideoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lora"
                    android:textStyle="bold"
                    android:textColor="@color/h_text"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/tvMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/manrope"
                    android:textColor="@color/h_text2"
                    android:textSize="12sp" />

                <com.example.manualapp.ui.widget.GirihDividerView
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:id="@+id/descHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tavsif"
                        android:fontFamily="@font/manrope"
                        android:textStyle="bold"
                        android:textColor="@color/h_text"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/descChevron"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/nq_chevdown"
                        app:tint="@color/h_text2"
                        android:contentDescription="@null" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="24dp"
                    android:text="Tavsif yuklanmoqda…"
                    android:fontFamily="@font/manrope"
                    android:textColor="@color/h_text2"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
