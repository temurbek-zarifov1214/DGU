<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="124dp"
    android:background="@drawable/bg_h_card"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/learnOrnament"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:src="@drawable/nq_ornament_corner"
        android:alpha="0.14"
        app:tint="@color/h_turq"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/learnTile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tile_turq">

            <ImageView
                android:id="@+id/learnIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                app:tint="@color/h_turq"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/learnTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/manrope"
            android:textStyle="bold"
            android:textColor="@color/h_text"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.15" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp" />

        <TextView
            android:id="@+id/learnCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_h_goldpill"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:fontFamily="@font/manrope"
            android:textStyle="bold"
            android:textColor="@color/h_gold"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
