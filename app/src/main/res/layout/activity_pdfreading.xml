<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/h_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="36dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/nq_back"
                app:tint="@color/h_text"
                android:background="@drawable/bg_h_circle_btn"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Orqaga" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lora"
                    android:textStyle="bold"
                    android:textColor="@color/h_text"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvSubLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/manrope"
                    android:textColor="@color/h_text2"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnTheme"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/nq_moon"
                app:tint="@color/h_gold"
                android:background="@drawable/bg_h_circle_btn"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Oʻqish rejimi" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/nq_share"
                app:tint="@color/h_text"
                android:background="@drawable/bg_h_circle_btn"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Ulashish" />
        </LinearLayout>

        <!-- Gold reading-progress bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:orientation="horizontal"
            android:background="@color/h_border">

            <View
                android:id="@+id/progressFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.02"
                android:background="@drawable/bg_h_progress" />

            <View
                android:id="@+id/progressRest"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.98" />
        </LinearLayout>

        <!-- PDF surface -->
        <com.github.barteksc.pdfviewer.PDFView
            android:id="@+id/pdfView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Floating page-nav pill -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_h_pill_dark"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/nq_back"
            app:tint="@color/h_text2"
            android:background="@drawable/bg_h_circle_btn"
            android:scaleType="centerInside"
            android:padding="7dp"
            android:contentDescription="Oldingi" />

        <TextView
            android:id="@+id/tvPageInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="56dp"
            android:gravity="center"
            android:text="1 / 1"
            android:fontFamily="@font/manrope"
            android:textStyle="bold"
            android:textColor="@color/h_text"
            android:textSize="13sp"
            android:letterSpacing="0.04" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/nq_chevron"
            app:tint="@color/h_text"
            android:background="@drawable/bg_h_circle_btn"
            android:scaleType="centerInside"
            android:padding="7dp"
            android:contentDescription="Keyingi" />
    </LinearLayout>

</FrameLayout>
