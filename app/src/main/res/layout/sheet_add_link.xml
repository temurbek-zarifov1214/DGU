<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_h_sheet"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="26dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#2EFFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Video havolasini qoʻshish"
            android:fontFamily="@font/lora"
            android:textStyle="bold"
            android:textColor="@color/h_text"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/nq_close"
            app:tint="@color/h_text2"
            android:background="@drawable/bg_h_circle_btn"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:contentDescription="Yopish" />
    </LinearLayout>

    <com.example.manualapp.ui.widget.GirihDividerView
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/inputRow"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_h_input"
        android:paddingStart="14dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/linkIcon"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/nq_link"
            app:tint="@color/h_text2"
            android:contentDescription="@null" />

        <EditText
            android:id="@+id/etLink"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:hint="https://youtube.com/watch?v=..."
            android:textColorHint="@color/h_text2"
            android:textColor="@color/h_text"
            android:fontFamily="@font/manrope"
            android:textSize="14sp"
            android:background="@null"
            android:inputType="textUri"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnPaste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Joylash"
            android:fontFamily="@font/manrope"
            android:textStyle="bold"
            android:textColor="@color/h_gold"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="YouTube yoki boshqa video havolasini joylashtiring — video avtomatik roʻyxatga qoʻshiladi."
        android:fontFamily="@font/manrope"
        android:textColor="@color/h_text2"
        android:textSize="12sp"
        android:lineSpacingMultiplier="1.2" />

    <Button
        android:id="@+id/btnAdd"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:text="Qoʻshish"
        android:fontFamily="@font/manrope"
        android:textStyle="bold"
        android:textColor="@color/h_text2"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:background="@drawable/bg_h_btn_disabled"
        android:enabled="false" />
</LinearLayout>
