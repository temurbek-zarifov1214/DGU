<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="13dp"
    android:paddingBottom="13dp"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:background="?attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_h_info_circle">

        <ImageView
            android:id="@+id/infoIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            app:tint="@color/h_text2"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="13dp">

        <TextView
            android:id="@+id/infoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:textStyle="bold"
            android:textColor="@color/h_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/infoSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/manrope"
            android:textColor="@color/h_text2"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:src="@drawable/nq_chevron"
        app:tint="@color/h_gold"
        android:contentDescription="@null" />
</LinearLayout>
